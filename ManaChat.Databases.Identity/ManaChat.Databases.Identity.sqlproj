<Project Sdk="Microsoft.Build.Sql/2.1.0">
  <PropertyGroup>
    <TargetPlatform>Sql160</TargetPlatform>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <TargetDatabaseSet>True</TargetDatabaseSet>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Tables" />
    <Folder Include="StoredProcedures" />
    <Folder Include="Schemas" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyLoader.cs" />
  </ItemGroup>
  <ItemGroup>
    <Build Include="Tables\external_server.sql" />
    <Build Include="Tables\identities.sql" />
    <Build Include="Tables\relationships.sql" />
    <Build Include="Tables\sessions.sql" />
    <Build Include="Tables\users.sql" />
    <Build Include="StoredProcedures\usp_identities_get_for_user.sql" />
    <Build Include="StoredProcedures\usp_identity_delete.sql" />
    <Build Include="StoredProcedures\usp_identity_get.sql" />
    <Build Include="StoredProcedures\usp_identity_save.sql" />
    <Build Include="StoredProcedures\usp_relationship_get_between_users.sql" />
    <Build Include="StoredProcedures\usp_relationship_save.sql" />
    <Build Include="StoredProcedures\usp_relationships_get_for_user.sql" />
    <Build Include="StoredProcedures\usp_session_delete.sql" />
    <Build Include="StoredProcedures\usp_session_get_by_token.sql" />
    <Build Include="StoredProcedures\usp_session_save.sql" />
    <Build Include="StoredProcedures\usp_user_delete.sql" />
    <Build Include="StoredProcedures\usp_user_get_by_id.sql" />
    <Build Include="StoredProcedures\usp_user_get_by_username.sql" />
    <Build Include="StoredProcedures\usp_user_save.sql" />
    <Build Include="StoredProcedures\usp_user_save_password.sql" />
    <Build Include="StoredProcedures\usp_user_search_by_username.sql" />
    <Build Include="StoredProcedures\usp_user_verify_details_available.sql" />
    <Build Include="Schemas\identity.sql" />
  </ItemGroup>
</Project>